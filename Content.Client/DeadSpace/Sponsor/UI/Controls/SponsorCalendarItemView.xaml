<Control xmlns="https://spacestation14.io">
    <BoxContainer Margin="8,8,8,8" Orientation="Vertical">
        <BoxContainer Orientation="Vertical">
            <BoxContainer HorizontalExpand="True" Orientation="Vertical">
                <Label Name="ItemName" HorizontalExpand="True" />
                <TextureRect
                    Name="ItemTexture"
                    Margin="0,0,4,0"
                    MinSize="48 48"
                    Stretch="KeepAspectCentered"
                    Visible="False"/>
                <Control MinWidth="5" />
                <RichTextLabel Name="ItemDescription" />
            </BoxContainer>
            <Label Name="DateTaken" HorizontalExpand="True" />
            <Button Name="GetButton" />
        </BoxContainer>
    </BoxContainer>
</Control>
