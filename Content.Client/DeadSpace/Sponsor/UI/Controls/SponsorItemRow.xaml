<Control xmlns="https://spacestation14.io">
    <BoxContainer Margin="8,8,8,8" Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Name="StoreItemName" HorizontalExpand="True" />
            <Label Name="DiscountSubText"
                   HorizontalAlignment="Right"/>
            <Button
                Name="StoreItemGetButton"
                MinWidth="64"
                HorizontalAlignment="Right"
                StyleClasses="Caution"
                Access="Public" />
            <BoxContainer Orientation="Horizontal" Name="RentButtons">
                <OptionButton Name="Currency"/>
                <OptionButton Name="Range"/>
                <Button Name="BuyButton"/>
            </BoxContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="HighDivider" />
        <BoxContainer HorizontalExpand="True" Orientation="Horizontal">
            <TextureRect
                Name="StoreItemTexture"
                Margin="0,0,4,0"
                MinSize="48 48"
                Stretch="KeepAspectCentered" />
            <Control MinWidth="5"/>
            <RichTextLabel Name="StoreItemDescription" />
        </BoxContainer>
    </BoxContainer>
</Control>
