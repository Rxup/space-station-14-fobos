<tabs:GeneralTab xmlns="https://spacestation14.io"
                 xmlns:tabs="clr-namespace:Content.Client.DeadSpace.Sponsor.UI.Tabs"
                 xmlns:ui="clr-namespace:Content.Client.DeadSpace.Sponsor.UI">

    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True">
            <PanelContainer VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Visible="True">
                    <ScrollContainer Name="CalendarList">
                        <!--  Category buttons are added here by code  -->
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
            <BoxContainer
                Orientation="Vertical"
                SizeFlagsStretchRatio="2"
                MinSize="100 256"
                VerticalExpand="True"
                HorizontalExpand="True"
                Visible="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Name="CalendarContainer">
                <!-- Weeks(calendar rows) -->
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</tabs:GeneralTab>
